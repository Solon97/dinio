{
  "meta": {
    "name": "Dinio Design System",
    "version": "1.0.0"
  },
  "colors": {
    "primary": {
      "50": "#f0fdfa",
      "100": "#ccfbf1",
      "200": "#99f6e4",
      "300": "#5eead4",
      "400": "#2dd4bf",
      "500": "#14b8a6",
      "600": "#0d9488",
      "700": "#0f766e",
      "800": "#115e59",
      "900": "#134e4a"
    },
    "neutral": {
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#475569",
      "700": "#334155",
      "800": "#1e293b",
      "900": "#0f172a"
    },
    "semantic": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "danger": "#f43f5e",
      "info": "#3b82f6",
      "background": "#f8fafc",
      "surface": "#ffffff"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', sans-serif"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "fontWeight": {
      "light": 300,
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "borders": {
    "radius": {
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "xl": "12px",
      "2xl": "16px",
      "3xl": "24px",
      "full": "9999px"
    },
    "width": {
      "default": "1px",
      "2": "2px"
    }
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "default": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
  },
  "components": {
    "card": {
      "background": "#ffffff",
      "borderRadius": "16px",
      "border": "1px solid #f1f5f9",
      "padding": "24px",
      "shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)"
    },
    "button": {
      "primary": {
        "background": "#0d9488",
        "text": "#ffffff",
        "hover": "#0f766e",
        "borderRadius": "12px",
        "padding": "12px 24px",
        "fontWeight": "700"
      },
      "secondary": {
        "background": "#f1f5f9",
        "text": "#64748b",
        "hover": "#e2e8f0",
        "borderRadius": "12px",
        "padding": "12px 24px",
        "fontWeight": "600"
      },
      "danger": {
        "text": "#f43f5e",
        "hoverBg": "#fff1f2",
        "padding": "8px"
      }
    },
    "input": {
      "background": "#ffffff",
      "border": "1px solid #e2e8f0",
      "borderRadius": "12px",
      "padding": "12px 16px",
      "focusRing": "2px solid #14b8a6",
      "placeholderColor": "#94a3b8"
    },
    "badge": {
      "borderRadius": "9999px",
      "padding": "2px 8px",
      "fontSize": "0.75rem",
      "fontWeight": "700"
    }
  }
}