# WhatsApp Cloud API
# The token you set when registering the webhook in Meta's developer dashboard
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Permanent system user access token (from Meta Business Manager)
WHATSAPP_TOKEN=your_access_token_here

# Phone Number ID from the Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_ID=your_phone_number_id_here

# OpenRouter AI Gateway
# Get your key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI model to use via OpenRouter (e.g. google/gemini-1.5-flash, anthropic/claude-haiku)
AI_MODEL=

# Server
PORT=3000
HOST=0.0.0.0

# Logging
# Levels: trace | debug | info | warn | error | fatal
# Only used in production (dev always uses debug + pino-pretty)
LOG_LEVEL=info

# Dinio backend integration (service-to-service)
DINIO_API_BASE_URL=
DINIO_BOT_INTERNAL_SECRET=

# Upstash Redis — chat session storage
# Create a Redis database at https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session encryption key — AES-256-GCM
# Must be exactly 32 bytes expressed as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
